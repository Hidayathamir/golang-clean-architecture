#!/bin/sh
# Pre-commit:
#   1. Regenerate docs/*.png if any docs/*.mermaid is staged.
#   2. Keep errkit.AddFuncName call arguments in sync with function names (auto-fix).
#   3. Enforce gofmt on staged Go files.
#   4. Run golangci-lint on staged Go packages (required — no skip).
#   5. Enforce project rules before the commit is created.
# Installed via `make setup` (sets core.hooksPath to .githooks).
#
# To bypass in an emergency: git commit --no-verify

set -e

# 1. Keep rendered diagrams in sync with their mermaid source.
staged_mermaid=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^docs/.*\.mermaid$' || true)
if [ -n "$staged_mermaid" ]; then
	echo "🎨 docs/*.mermaid changed -> regenerating diagrams..."
	if ! make diagram; then
		echo ""
		echo "❌ Commit blocked: diagram render failed (see make diagram)."
		exit 1
	fi
	git diff --name-only --diff-filter=ACM | grep -E '^docs/.*\.png$' | xargs -r git add
fi

# 2. Keep errkit.AddFuncName call sites in sync with the enclosing function.
#    Auto-fixes and re-stages; only fails if the tool itself errors.
staged_go=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.go$' || true)
if [ -n "$staged_go" ]; then
	if ! make add-func-name; then
		echo ""
		echo "❌ Commit blocked: add-func-name failed (see make add-func-name)."
		exit 1
	fi
	git add -u internal pkg cmd
fi

# 3. Enforce gofmt on staged Go files (auto-format + re-stage).
if [ -n "$staged_go" ]; then
	unformatted=$(gofmt -l $staged_go)
	if [ -n "$unformatted" ]; then
		echo "🎨 gofmt: reformatting staged Go files..."
		gofmt -w $staged_go
		echo "$staged_go" | xargs -r git add
	fi
fi

# 4. Run golangci-lint on packages touched by staged Go files.
#    Required: commit is blocked when golangci-lint is not installed.
if [ -n "$staged_go" ]; then
	if ! command -v golangci-lint >/dev/null 2>&1; then
		echo ""
		echo "❌ Commit blocked: golangci-lint not found."
		echo "   Install: go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest"
		exit 1
	fi
	echo "🔍 golangci-lint on staged packages..."
	if ! make lint; then
		echo ""
		echo "❌ Commit blocked: golangci-lint failed."
		echo "   Fix the issues above, or bypass with: git commit --no-verify"
		exit 1
	fi
fi

# 5. Enforce project rules.
if ! make check-rules; then
	echo ""
	echo "❌ Commit blocked: project rules violated (see make check-rules)."
	echo "   Fix the issues above, or bypass with: git commit --no-verify"
	exit 1
fi