{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "edit", "resource": "internal/mock/*", "effect": "deny" },
    { "action": "edit", "resource": "api/*", "effect": "deny" },
    { "action": "edit", "resource": "logs/*", "effect": "deny" }
  ],
  "mcp": {
    "servers": {
      "dbhub": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@bytebase/dbhub@latest",
          "--transport",
          "stdio",
          "--config",
          "config/dbhub.toml"
        ]
      },
      "kafka": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@infoinlet/mcp-kafka"
        ],
        "environment": {
          "KAFKA_BROKERS": "localhost:9093"
        }
      },
      "clickhouse": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@arvoretech/clickhouse-mcp"
        ],
        "environment": {
          "CLICKHOUSE_URL": "http://localhost:8123",
          "CLICKHOUSE_USER": "default",
          "CLICKHOUSE_PASSWORD": "",
          "CLICKHOUSE_DATABASE": "signoz_traces"
        }
      }
    }
  }
}